{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Evidence Record",
  "type": "object",
  "required": [
    "id",
    "target",
    "claim",
    "mapped_asi",
    "evidence_type",
    "artifacts",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "mapped_asi": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ASI[0-9]{2}$"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "benchmark_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "owasp_landscape",
        "vendor_docs",
        "benchmark_backed",
        "runtime_log",
        "community_review",
        "inferred"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "accepted",
        "rejected",
        "needs_benchmark"
      ]
    },
    "score_change_allowed": {
      "type": "boolean",
      "default": false
    }
  }
}